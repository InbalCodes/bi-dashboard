# Postgres connection string (Neon / Vercel Postgres)
DATABASE_URL=

# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full private key including the BEGIN/END lines, with \n escaped, wrapped in quotes.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Public preview mode: allow portfolio/demo users to browse the dashboard without login,
# while keeping manager-only sections protected.
PUBLIC_PREVIEW=false

# AI providers
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Auth
AUTH_SECRET=

# Manager demo user - full access to all data and to /settings
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# Salesperson demo user (optional) - sees only their own data, no /settings access.
# DEMO_SALESPERSON_NAME must exactly match a "salesperson" value in the sheet, e.g. "נועה ברק".
DEMO_SALESPERSON_EMAIL=
DEMO_SALESPERSON_PASSWORD=
DEMO_SALESPERSON_NAME=

# Protects /api/cron/sync from being called by anyone but Vercel Cron
CRON_SECRET=
